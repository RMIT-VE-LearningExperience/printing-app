rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Printer, paper, and colour thumbnails — public read, no client write
    match /printers/{allPaths=**} {
      allow read: if true;
      allow write: if false; // uploads are server-side only (Firebase Admin SDK bypasses these rules)
    }

    match /papers/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // Step images — public read, no client write
    match /images/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
